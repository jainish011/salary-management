# ─── DATABASE ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=acme_user
DB_PASSWORD=acme_pass
DB_NAME=acme_salary

# ─── REDIS ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=acme_redis_pass

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_before_production
JWT_EXPIRES_IN=24h

# ─── APP ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── FRONTEND (Vite) ─────────────────────────────────────────────────────────
# Used by Vite dev server for API proxy
VITE_API_BASE_URL=http://localhost:3000/api/v1
